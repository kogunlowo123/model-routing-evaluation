{
  "$defs": {
    "Attempt": {
      "properties": {
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        },
        "outcome": {
          "$ref": "#/$defs/AttemptOutcome"
        },
        "provider": {
          "title": "Provider",
          "type": "string"
        },
        "try_number": {
          "title": "Try Number",
          "type": "integer"
        }
      },
      "required": [
        "provider",
        "outcome",
        "try_number"
      ],
      "title": "Attempt",
      "type": "object"
    },
    "AttemptOutcome": {
      "enum": [
        "success",
        "failed",
        "skipped_circuit_open"
      ],
      "title": "AttemptOutcome",
      "type": "string"
    },
    "Candidate": {
      "description": "A provider that passed every hard filter, with the scores used to order it.",
      "properties": {
        "estimated_cost_usd": {
          "minimum": 0,
          "title": "Estimated Cost Usd",
          "type": "number"
        },
        "model": {
          "title": "Model",
          "type": "string"
        },
        "provider": {
          "title": "Provider",
          "type": "string"
        },
        "sampled_cost_usd": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sampled Cost Usd"
        },
        "sampled_latency_ms": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sampled Latency Ms"
        },
        "sampled_quality": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sampled Quality"
        },
        "utility": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Utility"
        }
      },
      "required": [
        "provider",
        "model",
        "estimated_cost_usd"
      ],
      "title": "Candidate",
      "type": "object"
    },
    "Exclusion": {
      "properties": {
        "detail": {
          "title": "Detail",
          "type": "string"
        },
        "provider": {
          "title": "Provider",
          "type": "string"
        },
        "reason": {
          "$ref": "#/$defs/ExclusionReason"
        }
      },
      "required": [
        "provider",
        "reason",
        "detail"
      ],
      "title": "Exclusion",
      "type": "object"
    },
    "ExclusionReason": {
      "enum": [
        "not_in_pool",
        "classification_ceiling",
        "task_not_served",
        "no_compliance_profile",
        "residency",
        "baa_required",
        "cost_ceiling"
      ],
      "title": "ExclusionReason",
      "type": "string"
    },
    "Strategy": {
      "enum": [
        "learned",
        "priority",
        "cost"
      ],
      "title": "Strategy",
      "type": "string"
    },
    "Usage": {
      "properties": {
        "input_tokens": {
          "title": "Input Tokens",
          "type": "integer"
        },
        "output_tokens": {
          "title": "Output Tokens",
          "type": "integer"
        }
      },
      "required": [
        "input_tokens",
        "output_tokens"
      ],
      "title": "Usage",
      "type": "object"
    }
  },
  "$id": "https://github.com/kogunlowo123/model-routing-evaluation/schemas/route.response.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "attempts": {
      "items": {
        "$ref": "#/$defs/Attempt"
      },
      "title": "Attempts",
      "type": "array"
    },
    "candidates": {
      "items": {
        "$ref": "#/$defs/Candidate"
      },
      "title": "Candidates",
      "type": "array"
    },
    "cost_usd": {
      "title": "Cost Usd",
      "type": "number"
    },
    "decision_id": {
      "title": "Decision Id",
      "type": "string"
    },
    "excluded": {
      "items": {
        "$ref": "#/$defs/Exclusion"
      },
      "title": "Excluded",
      "type": "array"
    },
    "failed_over": {
      "title": "Failed Over",
      "type": "boolean"
    },
    "family": {
      "title": "Family",
      "type": "string"
    },
    "finish_reason": {
      "title": "Finish Reason",
      "type": "string"
    },
    "latency_ms": {
      "title": "Latency Ms",
      "type": "number"
    },
    "model": {
      "title": "Model",
      "type": "string"
    },
    "policy_digest": {
      "title": "Policy Digest",
      "type": "string"
    },
    "policy_version": {
      "title": "Policy Version",
      "type": "string"
    },
    "provider": {
      "title": "Provider",
      "type": "string"
    },
    "redactions": {
      "title": "Redactions",
      "type": "integer"
    },
    "schema_valid": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "title": "Schema Valid"
    },
    "strategy": {
      "$ref": "#/$defs/Strategy"
    },
    "text": {
      "title": "Text",
      "type": "string"
    },
    "usage": {
      "$ref": "#/$defs/Usage"
    }
  },
  "required": [
    "decision_id",
    "family",
    "strategy",
    "provider",
    "model",
    "text",
    "finish_reason",
    "usage",
    "cost_usd",
    "latency_ms",
    "candidates",
    "excluded",
    "attempts",
    "failed_over",
    "schema_valid",
    "redactions",
    "policy_version",
    "policy_digest"
  ],
  "title": "RouteResult",
  "type": "object"
}
