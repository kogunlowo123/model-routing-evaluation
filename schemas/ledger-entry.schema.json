{
  "$defs": {
    "LedgerKind": {
      "enum": [
        "route",
        "shadow",
        "evaluation",
        "judge"
      ],
      "title": "LedgerKind",
      "type": "string"
    }
  },
  "$id": "https://github.com/kogunlowo123/model-routing-evaluation/schemas/ledger-entry.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "caller": {
      "title": "Caller",
      "type": "string"
    },
    "cost_usd": {
      "minimum": 0,
      "title": "Cost Usd",
      "type": "number"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "family": {
      "title": "Family",
      "type": "string"
    },
    "input_tokens": {
      "minimum": 0,
      "title": "Input Tokens",
      "type": "integer"
    },
    "kind": {
      "$ref": "#/$defs/LedgerKind"
    },
    "model": {
      "title": "Model",
      "type": "string"
    },
    "output_tokens": {
      "minimum": 0,
      "title": "Output Tokens",
      "type": "integer"
    },
    "provider": {
      "title": "Provider",
      "type": "string"
    },
    "reference": {
      "description": "Decision, evaluation run or shadow comparison id",
      "title": "Reference",
      "type": "string"
    }
  },
  "required": [
    "reference",
    "kind",
    "family",
    "provider",
    "model",
    "caller",
    "input_tokens",
    "output_tokens",
    "cost_usd",
    "created_at"
  ],
  "title": "LedgerEntry",
  "type": "object"
}
