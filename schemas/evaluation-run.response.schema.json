{
  "$defs": {
    "Interval": {
      "properties": {
        "high": {
          "title": "High",
          "type": "number"
        },
        "low": {
          "title": "Low",
          "type": "number"
        }
      },
      "required": [
        "low",
        "high"
      ],
      "title": "Interval",
      "type": "object"
    },
    "ProviderSummary": {
      "properties": {
        "cases": {
          "title": "Cases",
          "type": "integer"
        },
        "cost_per_pass_usd": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Cost Per Pass Usd"
        },
        "errors": {
          "title": "Errors",
          "type": "integer"
        },
        "latency_p50_ms": {
          "title": "Latency P50 Ms",
          "type": "number"
        },
        "latency_p95_ms": {
          "title": "Latency P95 Ms",
          "type": "number"
        },
        "mean_score": {
          "title": "Mean Score",
          "type": "number"
        },
        "pass_rate": {
          "title": "Pass Rate",
          "type": "number"
        },
        "pass_rate_ci95": {
          "$ref": "#/$defs/Interval"
        },
        "provider": {
          "title": "Provider",
          "type": "string"
        },
        "total_cost_usd": {
          "title": "Total Cost Usd",
          "type": "number"
        }
      },
      "required": [
        "provider",
        "cases",
        "errors",
        "pass_rate",
        "pass_rate_ci95",
        "mean_score",
        "latency_p50_ms",
        "latency_p95_ms",
        "total_cost_usd",
        "cost_per_pass_usd"
      ],
      "title": "ProviderSummary",
      "type": "object"
    },
    "RankedProvider": {
      "properties": {
        "comparisons": {
          "title": "Comparisons",
          "type": "integer"
        },
        "provider": {
          "title": "Provider",
          "type": "string"
        },
        "strength": {
          "title": "Strength",
          "type": "number"
        },
        "strength_ci95": {
          "$ref": "#/$defs/Interval"
        },
        "wins": {
          "title": "Wins",
          "type": "number"
        }
      },
      "required": [
        "provider",
        "strength",
        "strength_ci95",
        "wins",
        "comparisons"
      ],
      "title": "RankedProvider",
      "type": "object"
    },
    "RunStatus": {
      "enum": [
        "running",
        "completed",
        "failed"
      ],
      "title": "RunStatus",
      "type": "string"
    },
    "RunSummary": {
      "properties": {
        "excluded": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Excluded",
          "type": "object"
        },
        "judge_calibrated": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Judge Calibrated"
        },
        "providers": {
          "items": {
            "$ref": "#/$defs/ProviderSummary"
          },
          "title": "Providers",
          "type": "array"
        },
        "ranking": {
          "default": [],
          "items": {
            "$ref": "#/$defs/RankedProvider"
          },
          "title": "Ranking",
          "type": "array"
        }
      },
      "required": [
        "providers"
      ],
      "title": "RunSummary",
      "type": "object"
    }
  },
  "$id": "https://github.com/kogunlowo123/model-routing-evaluation/schemas/evaluation-run.response.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "completed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Completed At"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error"
    },
    "estimated_cost_usd": {
      "title": "Estimated Cost Usd",
      "type": "number"
    },
    "family": {
      "title": "Family",
      "type": "string"
    },
    "golden_digest": {
      "title": "Golden Digest",
      "type": "string"
    },
    "golden_set": {
      "title": "Golden Set",
      "type": "string"
    },
    "golden_version": {
      "title": "Golden Version",
      "type": "string"
    },
    "pairwise": {
      "title": "Pairwise",
      "type": "boolean"
    },
    "providers": {
      "items": {
        "type": "string"
      },
      "title": "Providers",
      "type": "array"
    },
    "requested_by": {
      "title": "Requested By",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/RunStatus"
    },
    "summary": {
      "anyOf": [
        {
          "$ref": "#/$defs/RunSummary"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "run_id",
    "golden_set",
    "golden_version",
    "golden_digest",
    "family",
    "providers",
    "pairwise",
    "status",
    "requested_by",
    "estimated_cost_usd",
    "created_at"
  ],
  "title": "EvaluationRun",
  "type": "object"
}
